{
  "name": "mocap-studio",
  "version": "1.0.0",
  "description": "Professional motion capture from webcam, Kinect v1 and Kinect v2",
  "main": "electron/main.js",
  "homepage": "./",
  "author": "MoCap Studio",
  "license": "MIT",

  "scripts": {
    "dev":          "concurrently \"npm run server\" \"npm run client\"",
    "server":       "nodemon server/index.js",
    "client":       "cd client && npm start",
    "build":        "cd client && npm run build",
    "start":        "node server/index.js",
    "install-all":  "npm install && cd client && npm install",

    "electron:dev":  "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "electron:win":  "npm run build && electron-builder --win"
  },

  "dependencies": {
    "cors":    "^2.8.5",
    "dotenv":  "^16.3.1",
    "express": "^4.18.2",
    "multer":  "^1.4.5-lts.1",
    "uuid":    "^9.0.0",
    "ws":      "^8.16.0"
  },

  "devDependencies": {
    "concurrently":    "^8.2.1",
    "nodemon":         "^3.0.1",
    "electron":        "^28.1.0",
    "electron-builder": "^24.9.1"
  },

  "build": {
    "appId":       "com.mocapstudio.app",
    "productName": "MoCap Studio",
    "copyright":   "Copyright © 2025 MoCap Studio",

    "files": [
      "electron/**/*",
      "client/build/**/*",
      "node_modules/**/*"
    ],

    "extraResources": [
      {
        "from": "server",
        "to":   "server",
        "filter": ["**/*", "!node_modules"]
      },
      {
        "from": "bridge",
        "to":   "bridge"
      }
    ],

    "directories": {
      "buildResources": "electron",
      "output":         "dist"
    },

    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon":            "electron/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },

    "nsis": {
      "oneClick":           false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon":      "electron/icon.png",
      "uninstallerIcon":    "electron/icon.png",
      "installerHeaderIcon":"electron/icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName":       "MoCap Studio"
    },

    "mac": {
      "category": "public.app-category.video",
      "icon":     "electron/icon.png",
      "target":   [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },

    "linux": {
      "icon":   "electron/icon.png",
      "target": [{ "target": "AppImage", "arch": ["x64"] }]
    }
  }
}
