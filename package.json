{
  "name": "eyetrain1",
  "version": "1.0.0",
  "description": "Professional photo to 3D model application with rigging and motion capture",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "test": "echo \"Tests coming soon\" && exit 0"
  },
  "keywords": [
    "3d",
    "model",
    "rigging",
    "mocap",
    "animation",
    "unreal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  }
}
